<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.roshancodespace.shonenx</id>
  <name>ShonenX</name>
  <summary>Minimal yet feature-rich Anime and Manga client</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  
  <developer id="com.roshancodespace">
    <name>Roshan Kumar Sharma</name>
  </developer>

  <description>
    <p>
      ShonenX is a cross-platform, minimal, yet feature-rich Anime and Manga client with seamless extension support, parallel progress tracking across AniList, MyAnimeList, and Kitsu, and native high-performance media playback.
    </p>
    <p>Key features:</p>
    <ul>
      <li>Parallel tracking across AniList, MyAnimeList, Kitsu, and Simkl</li>
      <li>Custom video player with gesture controls and styled subtitles</li>
      <li>Manga reader with webtoon, horizontal, and vertical reading modes</li>
      <li>Offline batch and single episode/chapter downloads</li>
      <li>Extension engine supporting Aniyomi and Mangayomi sources</li>
      <li>Modern fluid UI with AMOLED dark mode and custom palettes</li>
    </ul>
  </description>

  <launchable type="desktop-id">com.roshancodespace.shonenx.desktop</launchable>

